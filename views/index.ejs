<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/navigationBar.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search" action="/explore" method="GET">
                    <input class="form-control me-2" id="search-bar" name="q" type="search" placeholder="Search" value="<%= (typeof selected !== 'undefined' && selected.q) ? selected.q : '' %>">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>


    <div class="container">
        <div class="row">
            <div class="col-12 principal-info">
                <h1>FIND YOUR</h1>
                <h1>EDUCATIONAL OPPORTUNITY</h1>
                <p class="subtitle">Scholarships, Competitions and More for Students in Mexico.</p>
                <div class="row">
                    <div class="col-6">
                        <a href="/explore" class="btn btn-search-opportunities float-end">Search
                            opportunities</a>
                    </div>
                    <div class="col-6">
                        <a href="/contribute" class="btn btn-success btn-share-an-oportunity">Share an
                            opportunity</a>
                    </div>

                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-12">
                <h2>FEATURED OPPORTUNITIES</h2>
            </div>
        </div>

        <div class="row">
            <!-- left space -->
            <div class="col-0 col-lg-3"></div>
            <!-- cards row -->
            <div class="col-12 col-lg-6">
                <div class="row">
                    <%# Featured opportunities passed by GET /: the 3 verified ones with the most votes. %>
                    <% const featured = typeof featuredOpportunities !== 'undefined' && featuredOpportunities ? featuredOpportunities : []; %>
                    <%# Render one card per featured opportunity. %>
                    <% featured.forEach(function(o) { %>
                    <div class="col-6 col-lg-4 card-margin">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <img class="card-images"
                                    src="<%= o.imageUrl ? o.imageUrl : '/images/pfp.png' %>"
                                    alt="<%= o.title %>">
                                <h5 class="card-title"><%= o.title %></h5>
                                <p class="card-text"><%= o.description %></p>
                                <!-- Button goes here -->
                                <a href="/opportunity/<%= o._id %>" class="btn btn-primary mt-auto">View More</a>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                    <% if (!featured.length) { %>
                    <p>There are no featured opportunities yet.</p>
                    <% } %>
                </div>



            </div>
            <!-- right space -->
            <div class="col-0 col-lg-3"></div>
        </div>
    </div>
    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>