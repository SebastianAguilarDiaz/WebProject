<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - My Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/navigationBar.css">
    <link rel="stylesheet" href="/css/myProfile.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search" action="/explore" method="GET">
                    <input class="form-control me-2" id="search-bar" name="q" type="search" placeholder="Search" value="<%= (typeof selected !== 'undefined' && selected.q) ? selected.q : '' %>">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>

    <div class="container">

        <div class="title-container">
            <h1>MY PROFILE: ACCOUNT OVERVIEW</h1>
        </div>

        <div class="row">

            <!-- left column -->
            <div class="
                    col-10
                    my-4
                    mx-auto

                    col-lg-3
                    mx-lg-0">

                <!-- User info -->
                <div class="card shadow">
                    <div class="card-body d-flex flex-column">
                        <div class="row">
                            <img class="mx-auto my-2 pfp-img" src="/images/pfp.png" alt="Profile picture">

                            <h3 class="my-1"><%= user.name %></h3>
                            <p class="mb-3"><%= user.email %></p>

                            <div class="col-12">
                                <form action="/logout" method="POST" class="mt-2">
                                    <button type="submit" class="btn btn-outline-danger w-100">Log Out</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- middle column -->
            <div class="
                    col-12

                    col-lg-5">

                <h2>MY CONTRIBUTIONS</h2>

                <div class="card shadow my-3">
                    <div class="card-body d-flex flex-column">
                        <p class="card-text">OPPORTUNITIES SHARED: [<%= stats.shared %>]</p>
                        <p class="card-text">OPPORTUNITIES VERIFIED: [<%= stats.verified %>]</p>
                        <p class="card-text">COMMUNITY TRUST SCORE:</p>
                        <div class="progress" >
                            <div class="progress-bar bg-success" style="width: <%= stats.trustScore %>%"><%= stats.trustScore %>%</div>
                        </div>
                        <p class="card-text mt-3">VERIFIER RANK: [Level <%= stats.rank %>]</p>

                        <div class="row mt-2">
                            <div class="col-3">
                                <p class="card-text">BADGES</p>
                            </div>
                            <div class="col-9">
                                <div class="row">
                                    <% const userBadges = (typeof stats.badges !== 'undefined' && Array.isArray(stats.badges)) ? stats.badges : []; %>
                                    <% if (userBadges.length) { %>
                                        <% userBadges.forEach(function(badge) { %>
                                            <div class="col-5">
                                                <img src="<%= badge.image %>" alt="<%= badge.label %>" class="badges-img">
                                                <p><%= badge.label %></p>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex mt-2" style="align-items: center; flex-wrap: wrap;">
                            <p style="margin:0px;">NEXT RANK PROGRESS:</p>
                            <% const filled = typeof stats.squaresFilled !== 'undefined' ? stats.squaresFilled : 0; %>
                            <% const rankVal = typeof stats.currentRank !== 'undefined' ? stats.currentRank : stats.rank; %>
                            <% for (let i = 0; i < 5; i++) { %>
                                <% if (i < filled) { %>
                                    <div class="green-squares"></div>
                                <% } else { %>
                                    <div class="green-squares-outline"></div>
                                <% } %>
                            <% } %>
                            <% if (rankVal >= 5) { %>
                                <p style="margin:0px 0px 0px 8px;">Max rank</p>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <!-- right column -->
            <div class="
                    col-12

                    col-lg-4">
                <h2>MY SHARED OPPORTUNITIES</h2>

                <% if (typeof sharedOpportunities !== 'undefined' && sharedOpportunities.length > 0) { %>
                    <% sharedOpportunities.forEach(function(o) { %>
                    <div class="card shadow card-margin mb-2">
                        <div class="card-body d-flex flex-column">
                            <div class="col">
                                <div class="d-flex align-items-center">
                                    <img class="activity-img"
                                        src="<%= o.imageUrl ? o.imageUrl : '/images/pfp.png' %>"
                                        alt="<%= o.title %>">
                                    <div class="ms-3">
                                        <h3 class="h6 mb-0"><%= o.title %></h3>
                                        <p class="card-text small mb-0">
                                            <%= o.description ? o.description.substring(0, 60) : '' %>...
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-muted">You haven't shared any opportunities yet.</p>
                <% } %>
            </div>

        </div>

    </div>

    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>