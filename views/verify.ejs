<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - Verify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/navigationBar.css">
    <link rel="stylesheet" href="/css/verify.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search">
                    <input class="form-control me-2" id="search-bar" type="search" placeholder="Search">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>

    <div class="container">


        <div class="title-container">
            <h1>VERIFICATION PANEL: COMMUNITY VALIDATION</h1>
            <p class="title-description">Help the community ensure accuracy. Review and vote on contributions</p>
        </div>


        <div class="row">
            <!-- left space -->
            <div class="col-0 col-lg-1"></div>

            <!-- left column -->
            <div class="col-12 col-lg-7 left-column">
                

                <h2>QUEUE OF PENDING CONTRIBUTIONS</h2>

                <%# Pending contributions passed by GET /verify. %>
                <% const pending = typeof pendingOpportunities !== 'undefined' && pendingOpportunities ? pendingOpportunities : []; %>
                <%# Render one card per pending opportunity. %>
                <% pending.forEach(function(o) { %>
                <div class="card shadow card-margin">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex">
                            <h3>[<%= o.type %>] <%= o.title %></h3>
                        </div>
                        <div class="row">
                            <!-- left row -->
                            <div  class="col-7">
                                
                                <div class="row">
                                    <!-- opportunity img -->
                                    <div class="col-4">
                                        <img src="<%= o.imageUrl ? o.imageUrl : '/images/pfp.png' %>" alt="<%= o.title %>" class="card-img">
                                    </div>

                                    <!-- title and description -->
                                    <div class="col-8">
                                        <h4><%= o.title %></h4>
                                        <p><%= o.description %></p>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-12 col-lg-4">
                                        <a href="/opportunity/<%= o._id %>" class="btn btn-success"> Details & Review</a>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <p><span class="bi bi-calendar"></span> <%= o.deadline ? new Date(o.deadline).toLocaleDateString() : '' %></p>
                                        <p><span class="bi bi-geo-alt"></span> <%= o.location || '' %></p>

                                    </div>
                                </div>
                                <h4>Current Community Trust Score</h4>
                                <div class="progress" >
                                    <div class="progress-bar bg-success" style="width: <%= o.trustScore || 0 %>%"><%= o.trustScore || 0 %>%</div>
                                </div> 
                                

                            </div>
                            <!-- right row -->
                            <div class="col-5">
                                <h3>Verification Veredict</h3>
                                <%# Both buttons submit the same form with a different vote value. %>
                                <form action="/opportunity/<%= o._id %>/vote" method="POST">
                                    <button type="submit" name="vote" value="valid" class="btn btn-success btn-vote"><i class="bi bi-check-lg me-2"></i>Vote: Valid <i></i></button>
                                    <button type="submit" name="vote" value="invalid" class="btn btn-danger  btn-vote"><i class="bi bi-x-lg me-2"></i>Vote: Invalid/inaccurate</button>
                                </form>
                            </div>

                        </div>

                    </div>
                </div>
                <% }); %>

                <% if (!pending.length) { %>
                <p>There are no pending contributions.</p>
                <% } %>

                

            </div>

            <!-- right column -->
            <div class="col-12 col-lg-4">
                <h2>OVERVIEW OF YOUR VERIFICATION IMPACT</h2>
                <div class="row">
                    <div class="col-6">

                        <div class="card shadow card-margin card-h-margin">
                            <div class="card-body d-flex flex-column">
                                <p class="card-text">CONTRIBUTIONS YOU'VE VERIFIED (VALID): [25]</p>
                                
                            </div>
                        </div>
                    </div>

                    <div class="col-6">

                        <div class="card shadow card-margin card-h-margin">
                            <div class="card-body d-flex flex-column">
                                <p class="card-text">CONTRIBUTIONS YOU'VE FLAGGED (INVALID): [5]</p>
                                
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="card shadow card-margin card-h-margin">
                    <div class="card-body d-flex flex-column">
                        <p class="card-text">YOUR VERIFIER RANK: 4</p>

                        <div class="row">
                            <div class="col-3">
                                <p class="card-text">BADGES</p>
                            </div>
                            <div class="col-9">
                                <div class="row">

                                    <div class="col-5">
                                        <img src="/images/Check.png" alt="Check" class="badges-img">
                                        <p>Accuracy champion</p>
                                    </div>
                                    <div class="col-5">
                                        <img src="/images/securityissue.png" alt="Security Image" class="badges-img">
                                        <p>Community protector</p>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        <div class="d-flex" style="align-items: center;">
                            <p style="margin:0px;">NEXT RANK PROGRESS:</p>
                            <div class="green-squares"></div>
                            <div class="green-squares"></div>
                            <div class="green-squares"></div>
                            <div class="green-squares-outline"></div>
                            <div class="green-squares-outline"></div>

                        </div>

                    </div>
                </div>
                
                
                
                <h2>COMMUNITY VERIFICATION LEADERBOARD</h2>
                <div class="card shadow card-margin card-h-margin">
                    <div class="card-body d-flex flex-column">
                        <h4>Top 5 for highest-contributing verifiers</h4>
                        
                        <!-- first contributor -->
                        <div class="row d-flex row-alignment">
                            <div class="col-1 contribution-row">
                                <p class="contributors-text">1</p>
                            </div>
                            <div class="col-2 contribution-row d-flex">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2ObzdRfagDjC5sknqcooLXPC8HgumALrtPYj0JOXOMd-_-Ntv_P6TCOE&s=10" alt="Persona" class="contributors-img">
                            </div>
                            <div class="col-9 contribution-row">
                                <p class="contributors-text">Juan Pérez</p>
                            </div>
                        </div>
                        
                        <!-- second contributor -->
                        <div class="row d-flex row-alignment">
                            <div class="col-1 contribution-row">
                                <p class="contributors-text">2</p>
                            </div>
                            <div class="col-2 contribution-row d-flex">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2ObzdRfagDjC5sknqcooLXPC8HgumALrtPYj0JOXOMd-_-Ntv_P6TCOE&s=10" alt="Persona" class="contributors-img">
                            </div>
                            <div class="col-9 contribution-row">
                                <p class="contributors-text">Maria Gomez</p>
                            </div>
                        </div>

                        <!-- third contributor -->
                        <div class="row d-flex row-alignment">
                            <div class="col-1 contribution-row">
                                <p class="contributors-text">3</p>
                            </div>
                            <div class="col-2 contribution-row d-flex">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2ObzdRfagDjC5sknqcooLXPC8HgumALrtPYj0JOXOMd-_-Ntv_P6TCOE&s=10" alt="Persona" class="contributors-img">
                            </div>
                            <div class="col-9 contribution-row">
                                <p class="contributors-text">John Smith</p>
                            </div>
                        </div>
                        
                        <!-- forth contributor -->
                        <div class="row d-flex row-alignment">
                            <div class="col-1 contribution-row">
                                <p class="contributors-text">4</p>
                            </div>
                            <div class="col-2 contribution-row d-flex">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2ObzdRfagDjC5sknqcooLXPC8HgumALrtPYj0JOXOMd-_-Ntv_P6TCOE&s=10" alt="Persona" class="contributors-img">
                            </div>
                            <div class="col-9 contribution-row">
                                <p class="contributors-text">Robert Downey</p>
                            </div>
                        </div>

                        <!-- fifth contributor -->
                        <div class="row d-flex row-alignment">
                            <div class="col-1 contribution-row">
                                <p class="contributors-text">5</p>
                            </div>
                            <div class="col-2 contribution-row d-flex">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2ObzdRfagDjC5sknqcooLXPC8HgumALrtPYj0JOXOMd-_-Ntv_P6TCOE&s=10" alt="Persona" class="contributors-img">
                            </div>
                            <div class="col-9 contribution-row">
                                <p class="contributors-text">Christopher Evans</p>
                            </div>
                        </div>
                        
                        
                    </div>
                </div>
                
            </div>



        </div>

    </div>





    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>