<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - Explore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/navigationBar.css">
    <link rel="stylesheet" href="/css/Explore.css">

</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search" action="/explore" method="GET">
                    <input class="form-control me-2" id="search-bar" name="q" type="search" placeholder="Search" value="<%= (typeof selected !== 'undefined' && selected.q) ? selected.q : '' %>">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>


    <div class="container">   
        <form action="/explore" method="GET">
         <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="title-container mb-2">
            

                <h1>EXPLORE<br> EDUCATIONAL OPPORTUNITIES </h1>
                <div class = "btn-search-opportunities mb-2 ">
                    </a>Filter and discover your perfect match</a>
                </div>
                <div class="row mb-3 justify-content-center">
                    <div class="col-8 col-md-8">
                        <div class="d-flex search-bar"> 
                            <input class="form-control me-2" id="search-bar" name="q" type="search" placeholder="Search" value="<%= selected.q %>">
                        </div>
                    </div>

                    <div class="col-4 col-md-2">
                        <button class="btn btn-explore-filter" type="submit">Explore</button>
                    </div>
                </div>
            </div>
        </nav>
        
            <div class="container my-4">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-3 col-lg-2">
                            <div class="row">
                                <h4>Filters</h4>
                                
                            </div>

                            <%# Selected values keep the checkboxes checked after submitting the form. %>
                            <% const chosen = typeof selected !== 'undefined' ? selected : { area: [], level: [], type: [] }; %>

                            <div class="row">
                                <div class="col-6 col-md-12 mb-3">
                                    <label class="form-label small fw-bold text-secondary mb-1">
                                        Filter By Subject
                                    </label>
                                    <%# Checkboxes are generated from the schema enums so their values always match. %>
                                    <% OPPORTUNITY_AREAS.forEach(function(area) { %>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="area"
                                            value="<%= area %>" id="area-<%= area %>"
                                            <%= chosen.area.includes(area) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="area-<%= area %>"><%= area %></label>
                                    </div>
                                    <% }); %>
                                </div>

                                <div class="col-6 col-md-12 mb-3">
                                    <label class="form-label small fw-bold text-secondary mb-1">
                                        Filter By Level
                                    </label>
                                    <% OPPORTUNITY_GRADE_LEVELS.forEach(function(level) { %>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="level"
                                            value="<%= level %>" id="level-<%= level %>"
                                            <%= chosen.level.includes(level) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="level-<%= level %>"><%= level %></label>
                                    </div>
                                    <% }); %>
                                </div>

                                <div class="col-6 col-md-12 mb-3">
                                    <label class="form-label small fw-bold text-secondary mb-1">
                                        Filter By Type
                                    </label>
                                    <% OPPORTUNITY_TYPES.forEach(function(type) { %>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="type"
                                            value="<%= type %>" id="type-<%= type %>"
                                            <%= chosen.type.includes(type) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="type-<%= type %>"><%= type %></label>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                    </div>


                    <div class="col-9">
                        <div class= "row">
                            <h4>Search Result</h4>
                            <%# One card per opportunity returned by the Explore route. %>
                            <% (typeof opportunities !== 'undefined' && opportunities ? opportunities : []).forEach(function(o) { %>
                            <div class="col-12 col-sm-6 col-lg-3 card-margin">
                                <div class="card h-70">
                                    <div class="card-body d-flex flex-column">
                                        <div class="position-relative">
                                            <img class="card-images w-100"
                                                src="<%= o.imageUrl ? o.imageUrl : '/images/pfp.png' %>"
                                                alt="<%= o.title %>">
                                                <span class="badge bg-success position-absolute bottom-0 start-0 m-1">[ <%= o.type %> ]</span>
                                        </div>

                                        <h5 class="card-title fw-bold fs-6 mb-auto"><%= o.title %></h5>
                                        <p class="card-text text small mt-0"><%= o.description %></p>
                                        <!-- Button goes here -->
                                        <a href="/opportunity/<%= o._id %>" class="btn btn-success btn-sm py-0 px-2 fs-7 mt-0 rounded-3 align-self-start px-2">
                                            <small>View details</small>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                            <% if (!(typeof opportunities !== 'undefined' && opportunities && opportunities.length)) { %>
                            <p>There isn't any opportunity yet.<a href="/contribute"> Clic to share one!</a>!</p>
                            <% } %>



                        </div>
            </div>
                        
                        






                </div>
            </div>
        </form>
    </nav>

    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>