<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - Contribute</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/navigationBar.css">
    <link rel="stylesheet" href="/css/contribute.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search" action="/explore" method="GET">
                    <input class="form-control me-2" id="search-bar" name="q" type="search" placeholder="Search" value="<%= (typeof selected !== 'undefined' && selected.q) ? selected.q : '' %>">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>

    <div class="container">
        
        <div class="title-container">
            <h1>CONTRIBUTE: SHARE AN OPPORTUNITY</h1>
            <p class="title-description">Help build the database by sharing educational opportunities.</p>
        </div>

        <form action="/contribute" method="POST">
        <div class="row justify-content-center">

            <!-- basic information -->
            <div class="col-lg-5">
                <h2 class="text-center text-lg-start">STEP 1: Basic Information</h2>
                
                <h5>TITLE</h5>
                <input type="text" name="title" class="form-control element" placeholder="Enter title">
                
                <div class="row">
                    <div class="col-12">

                        <h5>TYPE</h5>
                        <select name="type" class="form-select btn-dropdown-custom element w-100">
                            <option value="" selected>Select opportunity type</option>
                            <option>Scholarships & Financial Aid</option>
                            <option>Competitions & Contests</option>
                            <option>Internships & Work Experiences</option>
                            <option>Research Programs</option>
                            <option>Conferences & Workshops</option>
                            <option>Summer Programs & Camps</option>
                            <option>Exchange & Study Abroad</option>
                            <option>Courses & Certifications</option>
                        </select>

                    </div>
                </div>
                
                <div class="row">
                    <div class="col-lg-4">
                        <h5>AREA</h5>
                            <div class="row">
                                <div class="col-12">
                                    <div class="row">
                                        <div class="col-6 col-md-12">

                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="area" value="Mathematics" id="math">
                                                <label class="form-check-label" for="math">Mathematics</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="area" value="Computer Science" id="cs">
                                                <label class="form-check-label" for="cs">Computer Science</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="area" value="Arts & Design" id="arts">
                                                <label class="form-check-label" for="arts">Arts & Design</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="area" value="Engineering" id="eng">
                                                <label class="form-check-label" for="eng">Engineering</label>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="col-lg-8">

                        <h5>GRADE LEVEL</h5>
                        <select name="gradeLevels" class="form-select btn-dropdown-custom element w-100">
                            <option value="" selected>Select grade level</option>
                            <option>Middle School</option>
                            <option>High School</option>
                            <option>Undergraduate</option>
                            <option>Postgraduate / Master's</option>
                            <option>Doctorate / PhD</option>
                            <option>Open to all levels</option>
                        </select>

                        <h5 class="mt-3">IMAGE URL</h5>
                        <input type="url" name="imageUrl" class="form-control element" placeholder="https://...">

                    </div>
                </div>
            </div>

            <!-- details -->
            <div class="col-lg-5">
                <h2 class="text-center text-lg-start">STEP 2: Details & Location</h2>
                <div class="row">
                    <div class="col-lg-6 d-flex flex-column">
                        <h5>DESCRIPTION</h5>
                        <textarea name="description" class="form-control resize-none flex-grow-1 element" placeholder="Write a brief description"></textarea>
                    </div>
                    <div class="col-lg-6">
                        <h5>DEADLINE</h5>
                        <input type="date" name="deadline" class="form-control element">

                        <h5>LOCATION</h5>
                        <input type="text" name="location" class="form-control element" placeholder="City, country or online">
                    </div>
                    <div class="col-lg-6"></div>
                </div>

                <h5>URL</h5>
                <input type="text" name="url" class="form-control element" placeholder="Website URL">

                <h5>KEYWORDS/TAGS</h5>
                <input type="text" name="tags" class="form-control element" placeholder="Comma-separated tags">
            </div>
        </div>

        <!-- buttons -->
        <div class="row justify-content-center mt-4">
            <div class="col-auto">
                <button type="submit" name="status" value="Pending" class="btn btn-success btn-submit">SUBMIT FOR VERIFICATION</button>
            </div>
        </div>
        </form>

    </div>

    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

<div class="container my-4">
