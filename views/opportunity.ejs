<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scholar Find - <%= typeof title !== 'undefined' && title ? title : 'Opportunity' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/navigationBar.css">
    <link rel="stylesheet" href="/css/opportunity.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-color">
        <div class="container">

            <a class="navbar-brand" href="/">
                Scholar Find
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sdgNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="sdgNav">
                <form class="d-flex search-bar" role="search">
                    <input class="form-control me-2" id="search-bar" type="search" placeholder="Search">

                    <button class="btn btn-success" type="submit">
                        Search
                    </button>
                </form>

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/explore">Explore</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contribute">Contribute</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/verify">Verify</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/myProfile">My Profile</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About</a>
                    </li>

                </ul>


            </div>
        </div>
    </nav>

    <div class="container">
        <div class="title-container">
            <h1><%= typeof title !== 'undefined' && title ? title : 'Opportunity title' %></h1>
            <p class="title-description"><%= typeof type !== 'undefined' && type ? type : 'Opportunity type' %></p>
        </div>

        <div class="row">
            <!-- left space -->
            <div class="col-0 col-lg-1"></div>

            <!-- left column: image + trust -->
            <div class="col-12 col-lg-7 left-column">
                <h2>OVERVIEW</h2>
                <div class="card shadow card-margin">
                    <div class="card-body d-flex flex-column">
                        <div class="row">
                            <div class="col-4">
                                <img src="<%= typeof image !== 'undefined' && image ? image : '/images/pfp.png' %>" alt="Opportunity image" class="card-img">
                            </div>
                            <div class="col-8">
                                <h3><%= typeof title !== 'undefined' && title ? title : 'Opportunity title' %></h3>
                                <p><%= typeof description !== 'undefined' && description ? description : 'Opportunity description' %></p>
                            </div>
                        </div>

                        <h4 class="mt-3">Current Community Trust Score</h4>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: <%= typeof trustScore !== 'undefined' && trustScore ? trustScore : 0 %>%"><%= typeof trustScore !== 'undefined' && trustScore ? trustScore : 0 %>%</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- right column: contribute details -->
            <div class="col-12 col-lg-4">
                <h2>DETAILS</h2>
                <div class="card shadow card-margin">
                    <div class="card-body d-flex flex-column">
                        <h5>TYPE</h5>
                        <p class="detail-value"><%= typeof type !== 'undefined' && type ? type : '' %></p>

                        <h5>AREA</h5>
                        <p class="detail-value"><%= typeof area !== 'undefined' && area ? (Array.isArray(area) ? area.join(', ') : area) : '' %></p>

                        <h5>GRADE LEVEL</h5>
                        <p class="detail-value"><%= typeof gradeLevels !== 'undefined' && gradeLevels ? (Array.isArray(gradeLevels) ? gradeLevels.join(', ') : gradeLevels) : '' %></p>

                        <h5>DEADLINE</h5>
                        <p class="detail-value"><%= typeof deadline !== 'undefined' && deadline ? deadline : '' %></p>

                        <h5>LOCATION</h5>
                        <p class="detail-value"><%= typeof location !== 'undefined' && location ? location : '' %></p>

                        <h5>URL</h5>
                        <% if (typeof url !== 'undefined' && url) { %>
                            <a href="<%= url %>" target="_blank" rel="noopener"><%= url %></a>
                        <% } else { %>
                            <p class="detail-value"></p>
                        <% } %>

                        <h5>KEYWORDS/TAGS</h5>
                        <div>
                            <% (typeof tags !== 'undefined' && tags ? (Array.isArray(tags) ? tags : [tags]) : []).forEach(function(tag) { %>
                                <span class="badge bg-success tag-badge"><%= tag %></span>
                            <% }); %>
                        </div>
                    </div>
                </div>

                <div class="card shadow card-margin mt-3">
                    <div class="card-body d-flex flex-column">
                        <button class="btn btn-success btn-vote"><i class="bi bi-check-lg me-2"></i>Vote: Valid</button>
                        <button class="btn btn-danger btn-vote"><i class="bi bi-x-lg me-2"></i>Vote: Invalid/inaccurate</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr>
    <p class="contact-info ">Contact us</p>
    <p class="contact-info">0281558@up.edu.mx</p>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
